# ============================================================
# Salon Booking System — environment template
# Copy to `.env` (docker-compose reads it automatically).
# ============================================================

# ---- Shared secrets ----
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=900          # 15 minutes (seconds)
JWT_REFRESH_TTL=1209600     # 14 days (seconds)

# ---- PostgreSQL (transactional services) ----
POSTGRES_USER=salon
POSTGRES_PASSWORD=salon_pw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Logical database-per-service (created by infra/postgres/init-multiple-dbs.sh)
IDENTITY_DB=identity_db
BOOKING_DB=booking_db
PAYMENT_DB=payment_db
LOYALTY_DB=loyalty_db
STAFF_DB=staff_db
REPORTING_DB=reporting_db
ADMIN_DB=admin_db

# ---- MongoDB (document services) ----
MONGO_HOST=mongo
MONGO_PORT=27017
CATALOGUE_DB=catalogue_db
SEARCH_DB=search_db
NOTIFICATION_DB=notification_db
REVIEW_DB=review_db

# ---- Seeded platform admin (Identity) ----
ADMIN_EMAIL=admin@salon.local
ADMIN_PASSWORD=admin12345

# ---- Redis (slot locks / cache) ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- RabbitMQ (event bus) ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=salon
RABBITMQ_PASSWORD=salon_pw
RABBITMQ_EXCHANGE=salon.events

# ---- Payment (mock gateway) ----
# When true, the payment service simulates a gateway instead of calling Stripe/PayHere.
PAYMENT_MOCK=true
PLATFORM_COMMISSION_PCT=10

# ---- Booking rules ----
SLOT_LOCK_TTL_SECONDS=600    # 10 min payment window before auto-release

# ---- Service ports (host-exposed) ----
GATEWAY_PORT=8080
IDENTITY_PORT=3001
CATALOGUE_PORT=3002
SEARCH_PORT=3003
BOOKING_PORT=3004
PAYMENT_PORT=3005
NOTIFICATION_PORT=3006
REVIEW_PORT=3007
LOYALTY_PORT=3008
STAFF_PORT=3009
REPORTING_PORT=3010
ADMIN_PORT=3011

# ---- Host port mappings for infra (chosen to avoid clashes with other
#      local projects; the CONTAINER ports stay standard, so internal
#      service-to-service networking is unaffected). Override if these clash. ----
MONGO_HOST_PORT=27018
REDIS_HOST_PORT=6380
RABBITMQ_HOST_PORT=5673
RABBITMQ_UI_PORT=15673
FRONTEND_HOST_PORT=5174
GATEWAY_HOST_PORT=8090

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8090
